PORT=3006
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=inventario
DB_USER=tu_usuario
DB_PASS=tu_contrasena
SEED_DEMO=true
# Opcional, para npm test. Debe existir y terminar en _test.
TEST_DB_NAME=inventario_test
# Solo si usas compose.yaml: cambia este valor antes de iniciarlo.
DB_ROOT_PASS=tu_contrasena_root
# Autenticación JWT: usa una cadena larga y aleatoria.
JWT_SECRET=cambia_esta_clave_secreta
JWT_EXPIRES_IN=8h
